# ==============================================================================
# ExLibris Environment Variables Template (.env.example)
#
# Copy this file to .env.local when testing live external APIs in a browser.
# Note: All automated tests (Vitest, Storybook VRT, Playwright IT) and production
# builds MUST pass 100% deterministically without .env.local using mock DI adapters.
# ==============================================================================

# Google OAuth 2.0 Web Client ID (for browser Google Identity Services / Drive API)
# Scopes used on real device / web: drive.readonly (ZIP streaming) & drive.appdata (DB backup/sync)
# If omitted or empty, Google Drive features operate with mock DI bridges or unlinked fallback.
VITE_GOOGLE_CLIENT_ID=""

# Optional API keys for bibliographic metadata providers (NDL Search & AniList require no key)
VITE_RAKUTEN_APP_ID=""
VITE_GOOGLE_BOOKS_API_KEY=""
